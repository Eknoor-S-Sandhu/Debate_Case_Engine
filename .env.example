# Copy to .env and enter credentials there. Never commit your real .env.
# Choose one: openai, anthropic, gemini. Model IDs must support structured output.
DEBATE_ENGINE_STRATEGY__PROVIDER=openai
DEBATE_ENGINE_STRATEGY__ALLOW_REMOTE=false

# Uncomment and configure only the providers you intend to use.
# Set STRATEGY__ALLOW_REMOTE=true to enable configured providers, or use the
# provider-specific ALLOW_REMOTE=true/false override to control each separately.
# DEBATE_ENGINE_OPENAI__API_KEY=your-openai-api-key
# DEBATE_ENGINE_OPENAI__MODEL=your-supported-openai-model
# DEBATE_ENGINE_OPENAI__ALLOW_REMOTE=true

# DEBATE_ENGINE_ANTHROPIC__API_KEY=your-anthropic-api-key
# DEBATE_ENGINE_ANTHROPIC__MODEL=your-supported-claude-model
# DEBATE_ENGINE_ANTHROPIC__ALLOW_REMOTE=true

# DEBATE_ENGINE_GEMINI__API_KEY=your-gemini-api-key
# DEBATE_ENGINE_GEMINI__MODEL=your-supported-gemini-model
# DEBATE_ENGINE_GEMINI__ALLOW_REMOTE=true

# Legacy OpenAI-only settings remain supported when OPENAI values are absent:
# DEBATE_ENGINE_STRATEGY__API_KEY=your-openai-api-key
# DEBATE_ENGINE_STRATEGY__MODEL=your-supported-openai-model

# Optional search, independent of inference provider choice:
# DEBATE_ENGINE_RESEARCH__API_KEY=your-tavily-api-key
